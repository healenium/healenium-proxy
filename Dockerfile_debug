FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="healenium"

ENV JAR=app.jar
ENV EXECUTABLE=run.sh

RUN apk upgrade --no-cache
WORKDIR /

COPY /target/hlm-proxy-*.jar /${JAR}
COPY run.sh /${EXECUTABLE}

RUN chmod +x /${EXECUTABLE}

EXPOSE 8085
EXPOSE 5005

CMD /${EXECUTABLE}

